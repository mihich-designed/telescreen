TELESCREEN_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/telescreen
TELESCREEN_KAFKA_BOOTSTRAP_SERVERS=localhost:9094
TELESCREEN_LOG_LEVEL=INFO

# Secrets referenced by pipelines (dsn: env:SHOP_DSN)
SHOP_DSN=postgresql://postgres:postgres@localhost:5433/shop

# Enable integration tests
TELESCREEN_TEST_SOURCE_DSN=postgresql://postgres:postgres@localhost:5433/shop
TELESCREEN_TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/telescreen_test
